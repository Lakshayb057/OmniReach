# =============================================================================
# OmniReach Broadcast Center - Environment Configuration
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=10000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Option A: Full Connection String (Recommended for Render, Neon, Supabase)
DATABASE_URL=postgresql://postgres:password@your-render-db-host:5432/broadcastengine

# Option B: Individual Credentials (for local development fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=BroadcastEngine
DB_SSL=false

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=omnireach_jwt_super_secret_enterprise_key_2026_change_in_production

# -----------------------------------------------------------------------------
# Initial Superadmin Account (Auto-seeded on first server startup)
# -----------------------------------------------------------------------------
SUPERADMIN_EMAIL=SuplerLucky@gmail.com
SUPERADMIN_PASSWORD=Lakshay@123

# -----------------------------------------------------------------------------
# Debug Options
# -----------------------------------------------------------------------------
DEBUG_SQL=false
